# Copy to .env (gitignored) and fill in.
#
# Multiple instances: keep one file per instance and select it with
# COMPANY_AI_ENV, or with the ./do <cmd> <config> shorthand. e.g. put Aito's
# own instance + port in .env.aito and run `./do dev aito`.
# All .env and .env.* files are gitignored except this template.

# Local docker instance default (see README quickstart). The image generates
# random API keys on first start and requires them; the quickstart runs it with
# -e AITO_DISABLE_AUTH=true (local use only), which is why the key is empty.
AITO_INSTANCE_URL=http://localhost:9005
AITO_API_KEY=

# Or a hosted Aito instance:
#AITO_INSTANCE_URL=https://your-aito-host.example/db/<database>
#AITO_API_KEY=<a read/write key for that database>

# --- .env.test (copy to .env.test; required to run the booktest suite) --------
# The suite reseeds — it drops and recreates tables — so it runs ONLY against a
# dedicated, throwaway test env whose path contains "booktest" or "test".
# book/__booktest__.py forces the suite onto this file and refuses any other
# target (production included). Leave COMPANY_AI_DATA_DIR unset here.
#AITO_INSTANCE_URL=https://your-aito-host.example/db/<database>/env/booktest
#AITO_API_KEY=<a read/write key for that env>
#COMPANY_AI_PORT=8779


# Optional: the dashboard port for this instance, so an endpoint and its port
# travel together. Read by `./do` and by `company-ai dashboard` (the --port
# flag still overrides). Defaults to 8770.
COMPANY_AI_PORT=8770

# Absolute path to the private dataset, OUTSIDE this repository.
# Expected contents: rolodex.csv, touches.csv (see docs/02-schema.md),
# sessions.csv (docs/09-funnels.md), posts.csv (docs/10), todos.csv (docs/12),
# deals.csv (docs/13-deals.md).
COMPANY_AI_DATA_DIR=

# Optional: default source dir for `company-ai documents-import` (docs/25) — a
# one-time bulk import of an existing markdown knowledge dir into the Documents
# store. Defaults to this repo's docs/; point it at the private knowledge dir
# (strategy, memory, notes) to import once.
COMPANY_AI_LIBRARY_DIR=

# Optional: remote MCP (docs/26). Set a strong random secret to expose the MCP
# server over HTTP at /mcp for cloud Claude (claude.ai connectors / Claude Code).
# Cloud Claude sends it as `Authorization: Bearer <token>`. UNSET = the /mcp
# endpoint is not mounted at all (fail closed). The remote surface is read + safe
# writes (destructive tools stay on the local stdio server). Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(40))"`.
#COMPANY_AI_MCP_TOKEN=

# Optional: OAuth for the remote MCP (docs/29). Set to the app's public HTTPS
# origin (e.g. https://ai.example.com) to host a self-hosted OAuth 2.1 server so
# claude.ai's "Add custom connector" dialog can authenticate to /mcp. UNSET =
# OAuth off; /mcp then accepts only the bearer token above. Requires the Easy
# Auth excluded-paths change in docs/29 (all OAuth paths except /authorize).
#COMPANY_AI_PUBLIC_URL=

# Optional: the LLM behind the three model surfaces (CLAUDE.md rule 1's scoped
# exceptions) — the week-prep composer (docs/15), the dashboard assistant
# (docs/16) and the routines runner (docs/18). UNSET = those surfaces report a
# missing key and everything else works; Aito access is separate and unaffected.
#
# Two providers. Naming an Azure endpoint selects azure; otherwise openai.
#COMPANY_AI_LLM_MODEL=gpt-5-mini
#COMPANY_AI_LLM_API_KEY=
#
# OpenAI (or any OpenAI-compatible base URL):
#COMPANY_AI_LLM_BASE_URL=
#
# Azure OpenAI:
#COMPANY_AI_LLM_AZURE_ENDPOINT=https://<resource>.api.cognitive.microsoft.com
#COMPANY_AI_LLM_AZURE_DEPLOYMENT=<your chat deployment>
#COMPANY_AI_LLM_AZURE_API_VERSION=2024-08-01-preview
#
# The REACT_APP_OPENAI_MODEL_{URL,DEPLOYMENT,API_KEY,API_VERSION,NAME} names are
# also read, so an environment that already carries them needs no rename.

# Optional: semantic / cross-lingual smart search (docs/23). Embeddings let a
# French or Finnish query find English documents, and a paraphrase find a note
# that shares no words with it. UNSET = embeddings off, search stays pure
# text-match. When set, run `./do reindex` (or MCP reindex_search) to BUILD the
# vectors — embedding happens at reindex, not on write, so the semantic layer
# stays dark until it runs.
#
# Either provider works. OpenAI needs only a model:
#COMPANY_AI_EMBED_MODEL=text-embedding-3-large
#
# Azure needs its endpoint; the deployment defaults to text-embedding-3-large:
#COMPANY_AI_EMBED_ENDPOINT=https://<resource>.api.cognitive.microsoft.com
#COMPANY_AI_EMBED_DEPLOYMENT=text-embedding-3-large
#COMPANY_AI_EMBED_API_VERSION=2024-02-01
#COMPANY_AI_EMBED_API_KEY=
#
# Both the endpoint and the key fall back to the CHAT resource's, so one Azure
# resource serving both needs nothing here beyond the LLM settings above. A key
# ALONE never switches embeddings on — an endpoint or a model has to say so,
# because the key already falls back and billing should not start by accident.
# `./do reindex` prints which provider it resolved, or which names are missing.

# Optional: the assistant's two external web tools (docs/16), both read-only
# and fenced off from internal numbers (rule 2). See docs/06-privacy: the query
# text and fetched URLs leave the machine.
#
# web_search — off unless a key is set; then the assistant can look up external
# facts (news, markets, people). Provider defaults to brave when a key is
# present; override with COMPANY_AI_SEARCH_PROVIDER.
#COMPANY_AI_SEARCH_API_KEY=
#COMPANY_AI_SEARCH_PROVIDER=brave
#COMPANY_AI_SEARCH_ENDPOINT=
#
# fetch_page — read one page by URL. Keyless and ON by default (SSRF-guarded to
# public addresses). Set to off to disable server-side page fetching.
#COMPANY_AI_WEB_FETCH=on
#
# Curate the assistant's tool registry (docs/16): a comma-separated allowlist.
# Empty = every available tool. Set it to expose only a subset (e.g. a fork
# that wants just the pipeline + web tools).
#COMPANY_AI_ASSISTANT_TOOLS=deal_pipeline,funnel,web_search,fetch_page

# The operator (docs/27). On a LOCAL instance, a request with no identity
# header is treated as this person, so a fresh install has full access out of
# the box. UNSET = such a request is a guest, and the operator-only views (Data
# tabs, the posts board, Admin) are hidden — which is why it ships set.
#
# For a hosted deployment behind Entra Easy Auth, change it to your own Entra
# email: that account becomes the bootstrap operator. The placeholder below is
# safe to leave on a hosted instance — a header-less request there gets no role
# at all, and no real sign-in carries this address.
COMPANY_AI_OPERATOR_EMAIL=operator@localhost

# Optional: the date this instance RECKONS FROM for overdue-ness, cold deals
# and routine due-state. UNSET (the default) = the real clock, which is what a
# live instance wants.
#
# Set it only for a fixed demo dataset. A seed with a fixed anchor rots: its
# newest row recedes from today until every deal reads as stalled and every
# todo as overdue, so the Now view's ranking says nothing and the product looks
# neglected rather than quiet. Declaring the reckoning date fixes that without
# moving any data — unlike shifting dates at load time, which drifts on every
# reseed and makes the instance stop matching data/seed/.
#
# It changes READS only. created / ts / last_done and every other write stamp
# keeps the real clock, so the changelog cannot be back-dated. Whenever this is
# set the dashboard says so in a banner: an instance quietly comparing against
# a date that is not today is the dishonest version of this.
#
# The repo's seed is generated around 2026-06-12 (scripts/generate_seed.py).
#COMPANY_AI_AS_OF=2026-06-12

# Optional: run this on YOUR company's vocabulary (docs/32). A JSON file naming
# the enum sets to replace — SEGMENTS, TIERS, DEAL_BLOCKERS, PLATFORMS and the
# rest of the descriptive vocabulary. Unset = this repo's own business, which
# is what the demo seed speaks. Validation stays strict either way: a value
# outside YOUR list still raises with the offending row.
#COMPANY_AI_VOCABULARY=./vocabulary.json
